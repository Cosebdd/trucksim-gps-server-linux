<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Funbit.Ets.Telemetry.Server</RootNamespace>
    <AssemblyName>TruckSimGPS_Server</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>TruckSim GPS</Product>
    <AssemblyTitle>TruckSim GPS Telemetry Server</AssemblyTitle>
    <Description>TruckSim GPS Telemetry Server</Description>
    <Company>Trinity014</Company>
    <Copyright>Copyright © Funbit 2016</Copyright>
    <Version>1.3.1.1</Version>
    <FileVersion>1.3.1.1</FileVersion>
    <AssemblyVersion>1.3.1.1</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="log4net" Version="3.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Ets2TestTelemetry.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="log4net.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
